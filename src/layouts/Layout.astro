---
const { pageTitle } = Astro.props;
import "../global.css"
---

<!doctype html>

<html lang="ja">

	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} - かたつむり</title>
	</head>

	<body>
		<header>
			<img src="/header.png"/>
			<nav>
				<a href="/">
					<span class="nav-btn">Home</span>
				</a>
				<a href="/articles">
					<span class="nav-btn">Articles</span>
				</a>
				<a href="/about">
					<span class="nav-btn">About</span>
				</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>

</html>